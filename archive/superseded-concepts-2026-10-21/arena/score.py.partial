      "impact": 0.5, "intelligence": 0.0}),
    ("2021 Ambani Africa", "overall", 0.5,
     {"product": 1.0, "creativity": 1.0, "usability": 0.5,
      "impact": 1.0, "intelligence": 0.0}),
    ("2022 Shoprite app", "overall", 0.5,
     {"product": 1.0, "creativity": 1.0, "sustainability": 1.0,
