     {"product": 0.5, "creativity": 0.5, "usability": 0.5,
      "impact": 1.0, "intelligence": 1.0}),
    ("2024 Jiinue", "hackathon", 1.0,
     {"product": 0.5, "creativity": 0.0, "impact": 1.0, "intelligence": 1.0}),
    ("2025 Usagey", "hackathon", 1.0,
     {"product": 1.0, "creativity": 0.0, "sustainability": 1.0,
      "impact": 0.0, "intelligence": 0.0}),
