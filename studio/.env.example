# These are opt-in local server settings. server.mjs does not auto-load this file.
# Set them in the shell before starting. No API keys belong in browser variables.
KAIRO_CLOUD_ENABLED=0
# gcloud uses the existing CLI login only for this Windows development machine.
# Leave unset in deployment, where GoogleAuth should use an attached service identity.
KAIRO_AUTH_MODE=gcloud
PORT=4173
