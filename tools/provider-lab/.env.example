# Copy to .env.local in this directory; this ignored file stays on your computer.
# Never use VITE_ variables for provider keys, or paste real keys into chat.
GROQ_API_KEY=
OPENROUTER_API_KEY=
KAIRO_GROQ_MODEL=openai/gpt-oss-20b
KAIRO_OPENROUTER_MODEL=openrouter/free
# Set only after confirming this Groq key belongs to a Free-plan account.
KAIRO_GROQ_FREE_PLAN_CONFIRMED=0
